// A restrained reading profile. Figures stay at their narrative position.
#set par(justify: false, leading: 0.65em)
#set text(hyphenate: false)
#set heading(numbering: none)
#show heading: set block(above: 1.2em, below: 0.6em, sticky: true)
#set figure(placement: none)
#show figure.where(kind: image): set block(breakable: false)
#show figure.caption: set text(size: 9pt)
#show image: set image(width: 100%)
#show raw.where(block: true): set block(fill: rgb("f4f5f7"), inset: 8pt, radius: 3pt)
#show raw: set text(size: 9pt)
#show quote.where(block: true): set block(stroke: (left: 2pt + rgb("60879b")), inset: (left: 10pt), above: 8pt, below: 8pt)
#set table(inset: 5pt, stroke: 0.4pt + rgb("c7cdd2"))
#show link: set text(fill: rgb("175b78"))
